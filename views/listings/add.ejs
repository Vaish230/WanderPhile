<%layout("/layouts/boilerplate")%>
  <body>
   <div class="col-8 offset-2">
      <h1>Add Post</h1> <hr />
    <form method="post" action="/listings/add" novalidate class="needs-validation" enctype="multipart/form-data">
      <div ><label class="form-label" for="title">Title: </label>
      <input name="listing[title]" type="text"  class="form-control" required/></div><br />
      
      <div >
      <label class="form-label" for="description" >Description: </label>
      <textarea name="listing[description]" type="text" class="form-control" required>
</textarea>
      </div><br />
      <!-- <div ><label class="form-label" for="image">Image Link: </label>
      <input name="listing[image]" type="text"  class="form-control" /></div><br /> -->
      <div ><label class="form-label" for="image">Upload Image: </label>
      <input name="listing[image]" style="padding: 0.65rem; " type="file"  class="form-control" required/></div><br />

      <div><label class="form-label" for="location">Location</label>
      <input name="listing[location]" type="text" class="form-control" required></div><br />
      <div class="row">
      <div class="col-6"><label class="form-label" for="price">Price: </label>
      <input
        name="listing[price]"
        type="text"
        class="form-control" required
      /></div><br />
      <div class="col-6"><label class="form-label" for="country">Country: </label>
      <input
        name="listing[country]"
        type="text"
        class="form-control"

        required
        
      /></div>
    <div>
      <br/>

      <div >
  <label class="form-label" for="category">Category:</label>

  <select
    name="listing[category]"
    class="form-control"
    required
    
  >
  <option value=""  >Select a category</option>
    <option value="Trending">Trending</option>
    <option value="Beach">Beach</option>
    <option value="Mountains">Mountains</option>
    <option value="Farm">Farm</option>
    <option value="Castle">Castle</option>
    <option value="Space">Space</option>
    <option value="Snow">Snow</option>
    <option value="Ferry">Ferry</option>
    <option value="City">City</option>
    <option value="Dome">Dome</option>
  </select>
  </div>
</div>

<br />
    </div></div><br />
      <button style=" margin-left:13rem;" class="btn btn-dark" type="submit">Add</button>
    </form></div><hr>
    <script src="" async defer></script>
  </body>
  
