<%layout("/layouts/boilerplate")%>
<%- include("../includes/flash.ejs")%>
<style>
  .filters {
    display: flex;
    flex-wrap:wrap;
  }

  .filter-link {
  text-decoration: none;
  color: black;
  display: inline-block;
}
  .filter {

    margin-top: 1rem;
    margin-right:1.5rem;
    text-align: center;
    padding:0.5rem;
    opacity:0.7;
  }
  .filter:hover {
    opacity:1;
    cursor: pointer;
  }
  .tax-switch {
    display: flex;
    margin-top: 1rem;
    margin-left: 1rem;
    height:3.5rem;
    border:1.8px rgba(82, 82, 82, 0.753) solid;
    border-radius:25px;
    padding:1rem;
  }
  #taxinfo{
    display:none;
  }

</style>
  <body>
    <div class="filters">
    <div class="filter">
      
      <a href="/listings/category/Trending" class="filter-link">
      <i class="fa-solid fa-fire"></i>
      <p>Trending</p>
      </a>
      
    </div>
    
    
    <div class="filter">
      <a href="/listings/category/Mountains" class="filter-link">
      <i class="fa-solid fa-mountain"></i>
      <p>Mountains</p>
      </a>
    </div>
    
    
    <div class="filter">
      <a href="/listings/category/Farm" class="filter-link">
      <i class="fa-solid fa-warehouse"></i>
      <p>Farm</p>
    </a>
    </div>
    
    
    <div class="filter">
      <a href="/listings/category/Snow" class="filter-link">
      <i class="fa-solid fa-snowman"></i>
      <p>Snow</p>
      </a>
    </div>
    
    
    <div class="filter">
      <a href="/listings/category/Beach" class="filter-link">
      <i class="fa-solid fa-umbrella-beach"></i>
      <p>Beach</p>
      </a>
    </div>
    
    <div class="filter">
  <a href="/listings/category/City" class="filter-link">
  <i class="fa-regular fa-building"></i>
  <p>City</p>
  </a>
</div>
    
    <div class="filter">
      <a href="/listings/category/Castle" class="filter-link">
    <i class="fa-regular fa-chess-rook"></i>
    <p>Castle</p>
    </a>
    </div>
    
    
    <div class="filter">
      <a href="/listings/category/Space" class="filter-link">
    <i class="fa-solid fa-rocket"></i>
    <p>Space</p>
    </a>
</div>

<div class="filter">
  <a href="/listings/category/Ferry" class="filter-link">
  <i class="fa-solid fa-ferry"></i>
  <p>Ferry</p>
  </a>
</div>

<div class="filter">
  <a href="/listings/category/Dome" class="filter-link">
  <i class="fa-solid fa-igloo"></i>
  <p>Dome</p>
  </a>
</div>




<div class="tax-switch">
  
  <div class=" form-check form-switch form-check-reverse" >
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked" unchecked>
  <label class="form-check-label" for="switchCheckChecked" style="opacity:1 ;">Display Taxes and GST</label>
</div>
</div>
    </div>
    <div class="home"></div>
    <div class="row row-cols-1 row-cols-lg-4 row-cols-md-2 row-cols-sm-1">
    
    <%for(let list of allList){%>
      <div class="col">
        <a class="anch" href="/listings/<%=list._id%>">
      <div class="card col homecard">
        <img src="<%=list.image.url%>" class="card-img-top" alt="photo" style="height:15rem;" >
        <div class="card-body">
          <p ><b><%=list.title%></b><br>
            &#8377;<%= list.price ? list.price.toLocaleString("en-IN") : "0" %>/night<br>
          <i id="taxinfo">+18% GST</i></p>
            
        </div>
        </div></a>
      </div>
    <%}%>
    </div>
    </div>
    <script src="" async defer></script>
  </body>

  <script>
    const taxSwitch=document.getElementById("switchCheckChecked");
    taxSwitch.addEventListener("click",()=>{
        let taxInfo=document.querySelectorAll("#taxinfo");
        for(let tax of taxInfo){
            if(tax.style.display==="block"){
                tax.style.display="none";
            }
            else{
                tax.style.display="block";
            }
        }
    })
  
  </script>
  


