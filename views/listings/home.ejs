<%layout("/layouts/boilerplate")%>
<%- include("../includes/flash.ejs")%>
  <body>
    <div class="home">
    <h1>All List</h1><hr>
    <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-1">

    <%for(let list of allList){%>
      <div class="col">
        <a class="anch" href="/listings/<%=list._id%>">
      <div class="card col">
        <img src="<%=list.image.url%>" class="card-img-top" alt="photo" style="height:15rem;" >
        <div class="card-body">
          <p ><b><%=list.title%></b><br>
            &#8377;<%= list.price ? list.price.toLocaleString("en-IN") : "0" %>/night</p>
        </div>
        </div></a>
      </div>
    <%}%>
    </div>
    </div>
    <script src="" async defer></script>
  </body>

  


